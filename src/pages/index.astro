---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>👋 你好，我是 zhuyao</h1>
			<p>
				欢迎来到我的技术博客 <strong>Zhuyao 的博客</strong>。这里主要记录我在开发过程中的实践、
				踩坑经验与学习笔记，涵盖 Web 开发、自动化工具与一些有趣的折腾。
			</p>
			<p>想写点什么？在项目根目录运行下面的命令，即可打开本地发文后台：</p>
			<pre><code>node scripts/publish-server.mjs</code></pre>
			<p>或者你也可以直接在 <code>src/content/blog/</code> 下新建 Markdown 文件。</p>
			<h2>快速上手</h2>
			<ul>
				<li>文章存放在 <code>src/content/blog/</code>，每篇一个 <code>.md</code> 文件</li>
				<li>站点信息（站名、描述）在 <code>src/consts.ts</code></li>
				<li>导航与页脚在 <code>src/components/</code></li>
				<li>修改后推送到 <code>main</code> 分支，GitHub Actions 会自动构建并部署</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
